rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /cafes/{cafeId} {
      // Müşteri, slug ile kafeyi bulabilmeli; menü herkese açık okunabilir olmalı.
      allow read: if true;
      // Kafe bilgisini yalnızca sahibi güncelleyebilir.
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      // Yeni kafe kaydı yalnızca oturum açmış (owner) kullanıcı tarafından oluşturulabilir.
      allow create: if request.auth != null;

      match /menu/{itemId} {
        allow read: if true;
        allow write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/cafes/$(cafeId)).data.ownerId;
      }

      match /orders/{orderId} {
        // Müşteri anonim: sipariş oluşturabilmeli ve "popüler ürünler" için
        // sipariş geçmişini okuyabilmeli. Kişisel veri içermediği için genel okumaya açık.
        allow read: if true;
        allow create: if true;
        // Durum güncelleme/silme yalnızca oturum açmış personel (barista/owner) tarafından yapılabilir.
        // NOT: Uygulama şu an tek kafe için hardcoded CAFE_ID kullandığından (bkz. BaristaPage),
        // burada personelin bu kafeye ait olduğunu ayrıca doğrulamıyoruz. Çok-kiracılı barista
        // girişi eklendiğinde bu kural cafe-personel eşlemesiyle sıkılaştırılmalı.
        allow update, delete: if request.auth != null;
      }
    }
  }
}
